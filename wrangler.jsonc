{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-hypnosis",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  
  // KV Namespace for caching and quick access
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c4c98b3772334d738231312699854889",
      "preview_id": "c4c98b3772334d738231312699854889"
    }
  ],
  
  // Environment variables (stored securely with wrangler secret)
  // Use: npx wrangler pages secret put AI_API_KEY --project-name ai-hypnosis
  // Use: npx wrangler pages secret put OPENAI_API_KEY --project-name ai-hypnosis
}
